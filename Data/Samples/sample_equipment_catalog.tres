[gd_resource type="Resource" script_class="EquipmentCatalog" load_steps=17 format=3]

[ext_resource type="Script" path="res://Scripts/Data/equipment_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://Scripts/Data/mate_definition.gd" id="2_mate"]
[ext_resource type="Script" path="res://Scripts/Data/shield_definition.gd" id="3_shield"]
[ext_resource type="Script" path="res://Scripts/Data/main_arm_definition.gd" id="4_arm"]
[ext_resource type="Script" path="res://Scripts/Data/back_unit_definition.gd" id="5_back"]
[ext_resource type="Script" path="res://Scripts/Data/expansion_part_definition.gd" id="6_expansion"]
[ext_resource type="Script" path="res://Scripts/Data/equipment_effect.gd" id="7_effect"]
[ext_resource type="Script" path="res://Scripts/Data/mate_loadout.gd" id="8_loadout"]

[sub_resource type="Resource" id="CannonPreviewEffect"]
script = ExtResource("7_effect")
type = "visual_only_cannon"
parameters = {"preview_only": true}

[sub_resource type="Resource" id="MateSurveyor"]
script = ExtResource("2_mate")
id = "mate.proto.surveyor"
name = "MT-04 Surveyor"
weight = 72.0
compatible_mate_ids = PackedStringArray("mate.proto.surveyor")
description = "テストフィールド表示用の暫定機体データ。性能値はゲームバランスを定めない。"
tags = PackedStringArray("prototype", "sample")
durability_max = 320.0
mobility = 5.1
turn_rate = 1.4
load_limit = 150.0
base_weight = 72.0

[sub_resource type="Resource" id="ShieldSurvey"]
script = ExtResource("3_shield")
id = "shield.sample.01"
name = "Field Guard"
weight = 18.0
compatible_mate_ids = PackedStringArray("mate.proto.surveyor")
description = "テストフィールド表示用のサンプル盾。"
durability_max = 140.0
guard_time = 0.35

[sub_resource type="Resource" id="ArmSurvey"]
script = ExtResource("4_arm")
id = "arm.sample.01"
name = "Survey Carbine"
weight = 24.0
compatible_mate_ids = PackedStringArray("mate.proto.surveyor")
description = "テストフィールド表示用のサンプルメインアーム。"
weapon_type = "kinetic_tool"
damage = 30.0
accuracy = 82.0
range_min = 2.0
range_max = 35.0
fire_interval = 0.7
magazine_size = 12
reserve_ammo = 72
reload_time = 2.6
recoil = 0.4

[sub_resource type="Resource" id="LongCannon"]
script = ExtResource("5_back")
id = "back.sample.cannon"
name = "Long Cannon"
weight = 28.0
compatible_mate_ids = PackedStringArray("mate.proto.surveyor")
description = "第一小隊用の縦長キャノン砲。外観確認用で、射撃処理は未実装。"
unit_type = "cannon"
effect = SubResource("CannonPreviewEffect")
ammo_capacity = 18
reload_time = 4.0

[sub_resource type="Resource" id="ExpansionSurvey"]
script = ExtResource("6_expansion")
id = "expansion.sample.01"
name = "Survey Sensor"
weight = 7.0
compatible_mate_ids = PackedStringArray("mate.proto.surveyor")
description = "テストフィールド表示用のサンプル拡張パーツ。"
effects = Array[ExtResource("7_effect")]([])

[sub_resource type="Resource" id="LoadoutCannon"]
script = ExtResource("8_loadout")
mate_id = "mate.proto.surveyor"
shield_id = "shield.sample.01"
main_arm_id = "arm.sample.01"
back_unit_id = "back.sample.cannon"
expansion_id = "expansion.sample.01"

[sub_resource type="Resource" id="LoadoutStandard"]
script = ExtResource("8_loadout")
mate_id = "mate.proto.surveyor"
shield_id = "shield.sample.01"
main_arm_id = "arm.sample.01"
expansion_id = "expansion.sample.01"

[resource]
script = ExtResource("1_catalog")
mate_definitions = Array[ExtResource("2_mate")]([SubResource("MateSurveyor")])
shields = Array[ExtResource("3_shield")]([SubResource("ShieldSurvey")])
main_arms = Array[ExtResource("4_arm")]([SubResource("ArmSurvey")])
back_units = Array[ExtResource("5_back")]([SubResource("LongCannon")])
expansion_parts = Array[ExtResource("6_expansion")]([SubResource("ExpansionSurvey")])
sample_loadouts = Array[ExtResource("8_loadout")]([SubResource("LoadoutCannon"), SubResource("LoadoutStandard")])
